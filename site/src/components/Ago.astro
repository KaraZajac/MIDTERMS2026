---
// A timestamp that says how old it is: "12 min ago (Nov 1, 2026, 6:23 p.m. ET)".
// The build writes the absolute time; the script in Base.astro adds the age and
// keeps it current. Without JavaScript the absolute time stands alone.
import { fmtStamp } from "../lib/format.js";

interface Props {
  iso: string;
  /** Leave the year out: "Nov 1, 5:53 p.m. ET". */
  short?: boolean;
}
const { iso, short = false } = Astro.props;
const text = short ? fmtStamp(iso).replace(/, \d{4},/, ",") : fmtStamp(iso);
---

<time datetime={iso} data-ago>{text}</time>
