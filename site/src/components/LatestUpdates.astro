---
// What each refresh changed (data/site/changes.json): Democrats' chance of
// control, the polls that entered an average, and the races that moved two
// points or more. Static: the page is rebuilt with every refresh. The file
// stops changing at the deadline, when the forecast is frozen.
import Ago from "./Ago.astro";
import { changes, meta } from "../lib/data.js";
import { raceById, candShort, sideLabel } from "../lib/model.js";
import { pct1, margin, url } from "../lib/format.js";

const c = changes();
const frozen = (meta().phase ?? "forecast") !== "forecast";
const SHOWN = 4; // entries before "earlier updates"
const KEEP = 24; // twelve hours of 30-minute refreshes
const entries = (c?.entries ?? []).slice(0, KEEP);
const CH: [string, string][] = [["house", "House"], ["senate", "Senate"], ["governor", "Governors"]];

const label = (r: any) => (r.chamber === "house" ? r.short : r.title);
function delta(from: number, to: number) {
  const d = (to - from) * 100;
  return Math.abs(d) < 0.05 ? "no change" : `${d > 0 ? "+" : "−"}${Math.abs(d).toFixed(1)}`;
}
function view(e: any) {
  const polls = [...(e.polls ?? [])]
    .filter((q: any) => raceById(q.race))
    .sort((a: any, b: any) => (b.weight ?? 0) - (a.weight ?? 0))
    .slice(0, 4)
    .map((q: any) => {
      const r = raceById(q.race);
      return { r, text: `${q.pollster}${q.partisan ? ` (${q.partisan})` : ""}`, m: margin(q.margin, sideLabel(r, "d"), sideLabel(r, "r")) };
    });
  const moved = (e.moved ?? [])
    .filter((x: any) => raceById(x.race))
    .slice(0, 4)
    .map((x: any) => ({ r: raceById(x.race), ...x }));
  return { e, polls, moved };
}
const views = entries.map(view);
---

{
  views.length > 0 && (
    <section class="section">
      <h2>{frozen ? "The last updates before the freeze" : "Latest updates"}</h2>
      <p class="section-note">
        What each refresh changed: Democrats' chance of control, the polls that entered an average, and the races whose odds moved
        two points or more (Deluxe).
      </p>
      <ol class="upd-list">
        {views.slice(0, SHOWN).map(({ e, polls, moved }) => (
          <li>
            <p class="upd-when"><Ago iso={e.t} short /></p>
            <p class="upd-ch">
              {CH.filter(([k]) => e.chambers?.[k]).map(([k, name], i) => (
                <span>
                  {i > 0 && " · "}
                  {name} <strong>{pct1(e.chambers[k].to)}</strong> <span class="muted">({delta(e.chambers[k].from, e.chambers[k].to)})</span>
                </span>
              ))}
            </p>
            {e.polls_total > 0 && (
              <p>
                {e.polls_total} new poll{e.polls_total === 1 ? "" : "s"}
                {e.polls_total > polls.length ? ", the weightiest: " : ": "}
                {polls.map((q: any, i: number) => (
                  <>
                    {i > 0 && "; "}
                    {q.text} in <a href={url(`/${q.r.slug}/`)}>{label(q.r)}</a>, {q.m}
                  </>
                ))}
                .
              </p>
            )}
            {e.moved_total > 0 && (
              <p>
                Moved:{" "}
                {moved.map((x: any, i: number) => (
                  <>
                    {i > 0 && "; "}
                    <a href={url(`/${x.r.slug}/`)}>{label(x.r)}</a>, {candShort(x.r.d)} {pct1(x.from)} → {pct1(x.to)}
                  </>
                ))}
                {e.moved_total > moved.length && `; and ${e.moved_total - moved.length} more`}.
              </p>
            )}
          </li>
        ))}
      </ol>
      {views.length > SHOWN && (
        <details class="upd-more">
          <summary>{views.length - SHOWN} earlier update{views.length - SHOWN === 1 ? "" : "s"}</summary>
          <ol class="upd-list">
            {views.slice(SHOWN).map(({ e }) => (
              <li>
                <p class="upd-when"><Ago iso={e.t} short /></p>
                <p class="upd-ch">
                  {CH.filter(([k]) => e.chambers?.[k]).map(([k, name], i) => (
                    <span>
                      {i > 0 && " · "}
                      {name} <strong>{pct1(e.chambers[k].to)}</strong> <span class="muted">({delta(e.chambers[k].from, e.chambers[k].to)})</span>
                    </span>
                  ))}
                </p>
                <p class="muted">
                  {e.polls_total} new poll{e.polls_total === 1 ? "" : "s"}; {e.moved_total} race{e.moved_total === 1 ? "" : "s"} moved two points or more.
                </p>
              </li>
            ))}
          </ol>
        </details>
      )}
    </section>
  )
}

<style>
  .upd-list { list-style: none; margin: 0; padding: 0; max-width: 60em; }
  .upd-list li { padding: 12px 0; border-top: 1px solid var(--grid); font-size: 14px; color: var(--ink-2); }
  .upd-list li:first-child { border-top: 0; padding-top: 0; }
  .upd-list p { margin: 0 0 4px; }
  .upd-when { font-size: 13px; color: var(--muted); }
  .upd-ch { color: var(--ink); }
  .upd-ch strong { color: var(--ink-strong); font-variant-numeric: tabular-nums; }
  .upd-more > summary { cursor: pointer; padding: 8px 0; font-size: 13px; color: var(--muted); }
  .upd-more .upd-list li:first-child { border-top: 1px solid var(--grid); padding-top: 12px; }
</style>
