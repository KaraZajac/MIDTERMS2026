---
// Page head for a chamber page: the headline sentence per version.
import { summary } from "../lib/data.js";
import { VERSIONS } from "../lib/model.js";
import { favoured } from "../lib/format.js";
import Ago from "./Ago.astro";

interface Props { chamber: "house" | "senate" | "governor"; eyebrow: string }
const { chamber, eyebrow } = Astro.props;
const s = summary();
const c = s.chambers[chamber];
function line(v: string) {
  const p = c.versions[v].p_control;
  const dFav = p.D >= p.R;
  const f = favoured(dFav ? p.D : p.R);
  const party = dFav ? "Democrats" : "Republicans";
  if (chamber === "governor") {
    // Republicans hold most governorships going in, so Democrats "win" one and Republicans "keep" it
    return f ? `${party} ${f} ${dFav ? "win" : "keep"} a majority of governorships` : "The majority of governorships is a toss-up";
  }
  const name = chamber === "house" ? "House" : "Senate";
  return f ? `${party} ${f} ${dFav ? "win" : "keep"} the ${name}` : `The ${name} is a toss-up`;
}
---

<section class="page-head">
  <p class="eyebrow">{eyebrow}</p>
  {VERSIONS.map((v) => <h1 class={`v v-${v}`}>{line(v)}</h1>)}
  <slot />
  <p class="updated">Updated <Ago iso={s.generated} /></p>
</section>
