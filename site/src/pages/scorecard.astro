---
import Base from "../layouts/Base.astro";
import OthersTable from "../components/OthersTable.astro";
import { scorecard, summary, history, meta } from "../lib/data.js";
import { raceById, sideLabel, sideKey } from "../lib/model.js";
import { pct, fmtStamp, url, margin } from "../lib/format.js";

const sc = scorecard();
const s = summary();
const h = history();
const m = meta();
const exAnte = (h?.snapshots ?? []).filter((x: any) => x.ex_ante !== false);
const lastSnap = exAnte[exAnte.length - 1];
const NAMES: Record<string, string> = {
  lite: "Lite", classic: "Classic", deluxe: "Deluxe", ratings: "Raters' consensus", "lean-only": "Partisan lean only", "coin-flip": "Coin flip",
};
const board = sc ? Object.entries(sc.scoreboard ?? {}).sort((a: any, b: any) => (a[1].brier ?? 9) - (b[1].brier ?? 9)) : [];

// Election night (Kara's ask, Nov 4, through MIDTERMS2026): every contender graded
// on the races *called* so far, from scorecard.json's `provisional` (docs/site-data.md).
// Calls aren't results, so it stands apart from the record below and says so.
const prov = sc?.provisional && typeof sc.provisional === "object" && sc.provisional.scoreboard ? sc.provisional : null;
const provBoard = prov ? Object.entries(prov.scoreboard).filter(([, v]: any) => v && typeof v.brier === "number").sort((a: any, b: any) => a[1].brier - b[1].brier) : [];
const etClock = (iso: string) => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const t = d.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", timeZone: "America/New_York" }).replace("AM", "a.m.").replace("PM", "p.m.");
  const day = d.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "America/New_York" });
  return day === "Nov 3" ? `${t} ET` : `${day}, ${t} ET`;
};
// The chance the headline gave the winner: 1 decimal where whole percents would round to 50%.
const pWin = (p: number) => (p >= 0.495 && p < 0.505 ? `${(p * 100).toFixed(1)}%` : pct(p));
const provUpsets = prov
  ? (Array.isArray(prov.races) ? prov.races : [])
      .filter((x: any) => Array.isArray(x) && typeof x[2] === "number" && x[2] < 0.5)
      .sort((a: any, b: any) => a[2] - b[2])
  : [];
const resolvedCount = typeof sc?.resolved === "number" ? sc.resolved : (sc?.races?.length ?? 0);
const scored = [...(sc?.races ?? [])].sort((a: any, b: any) => (a.p_winner ?? 1) - (b.p_winner ?? 1));
---

<Base title="Scorecard" description="How MIDTERMS2026 will be graded: the frozen pre-election forecast against the results, race by race, next to the raters, a lean-only baseline and a coin flip.">
  <section class="page-head">
    <p class="eyebrow">Scorecard</p>
    <h1>{sc ? "How the forecast did" : "How the forecast will be graded"}</h1>
    <p class="lede">
      The forecast is frozen before the polls open ({fmtStamp(s.deadline)}). Git timestamps the frozen snapshot, so nothing made later can
      sneak into the record. After the polls close, each race is scored against its result.
    </p>
  </section>

  {prov && provBoard.length > 0 && (
    <section class="section provisional" id="provisional">
      <h2>Provisional: graded on the races called so far</h2>
      <p>
        {prov.called} race{prov.called === 1 ? "" : "s"} called as of {etClock(prov.asof)} (calls by civicAPI's decision desk, not final results).
      </p>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>Contender</th><th class="num">Brier</th><th class="num">Log loss</th><th class="num">Right calls</th></tr></thead>
          <tbody>
            {provBoard.map(([k, v]: any) => (
              <tr class={k === (sc.headline ?? "deluxe") ? "ours" : undefined}>
                <td>{NAMES[k] ?? k}{k === (sc.headline ?? "deluxe") ? " (headline)" : ""}</td>
                <td class="num">{v.brier.toFixed(4)}</td>
                <td class="num">{typeof v.log_loss === "number" ? v.log_loss.toFixed(4) : "—"}</td>
                <td class="num">{k === "coin-flip" ? "—" : typeof v.calls === "string" ? v.calls : typeof v.calls === "number" ? `${v.calls}/${v.n}` : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {provUpsets.length > 0 && (
        <p>
          <strong>Upsets: </strong>
          {provUpsets.map((x: any, i: number) => {
            const r = raceById(x[0]);
            return <>{i ? "; " : ""}{r ? <a href={url(`/${r.slug}/`)}>{r.chamber === "house" ? r.label : r.title}</a> : x[0]}: {x[1]} won; the forecast gave them {pWin(x[2])}</>;
          })}.
        </p>
      )}
      <p class="small ink-2">
        Lower is better for both scores; a coin flip calls no race, so it has no right calls. Most races called so far are safe seats, which flatter every forecast; the close races are the real test. The scorecard of record grades final results from Wikipedia's results tables as editors add them.
      </p>
      {prov.others && <OthersTable others={prov.others} id="others" note="Graded on the calls so far, not final results." />}
    </section>
  )}

  {sc ? (
    <>
      <p class="callout">
        Grading the forecast made {fmtStamp(sc.forecast_generated)} (<code>{sc.forecast}</code>, the <a href="https://github.com/KaraZajac/MIDTERMS2026/releases/tag/forecast-of-record">forecast of record</a>). {resolvedCount} race{resolvedCount === 1 ? "" : "s"} resolved
        so far, {sc.open_count} still open. Lower is better for both scores.
      </p>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>Forecaster</th><th class="num">Races</th><th class="num">Brier score</th><th class="num">Log loss</th><th class="num">Right calls</th></tr></thead>
          <tbody>
            {board.map(([k, v]: any) => (
              <tr class={k === (sc.headline ?? "deluxe") ? "ours" : undefined}>
                <td>{NAMES[k] ?? k}{k === (sc.headline ?? "deluxe") ? " (headline)" : ""}</td>
                <td class="num">{v.n}</td>
                <td class="num">{v.brier?.toFixed(4) ?? "—"}</td>
                <td class="num">{v.log_loss?.toFixed(3) ?? "—"}</td>
                <td class="num">{v.calls ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {scored.length > 0 && (
        <section class="section">
          <h2>Every resolved race, biggest surprises first</h2>
          <p class="section-note">The chance the headline forecast gave whoever won. A 30% candidate winning should happen about three times in ten; a scorecard full of them would mean the forecast was too sure.</p>
          <div class="table-scroll" style="max-height:720px;overflow:auto">
            <table class="data">
              <thead><tr><th>Race</th><th>Winner</th><th class="num">Margin</th><th class="num">Forecast for the winner</th><th class="num">Called</th></tr></thead>
              <tbody>
                {scored.map((x: any) => {
                  const r = raceById(x.id);
                  const dl = r ? sideLabel(r, "d") : "D", rl = r ? sideLabel(r, "r") : "R";
                  return (
                    <tr>
                      <td><a href={url(`/${x.slug ?? r?.slug}/`)}>{r ? (r.chamber === "house" ? r.label : r.title) : (x.label ?? x.id)}</a></td>
                      <td><span class={`key ${sideKey(x.winner)}`} />{x.winner_name ?? x.winner}</td>
                      <td class="num">{x.margin != null ? margin(x.margin, dl, rl) : "—"}</td>
                      <td class="num">{x.p_winner != null ? pct(x.p_winner) : "—"}</td>
                      <td class="num">{x.called_right ? "✓" : <strong>✗</strong>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {sc.open?.length > 0 && (
        <section class="section">
          <h2>Still open</h2>
          <p class="small ink-2">
            {sc.open.map((id: string, i: number) => {
              const r = raceById(id);
              return <>{i ? " · " : ""}{r ? <a href={url(`/${r.slug}/`)}>{r.chamber === "house" ? r.label : r.title}</a> : id}</>;
            })}
            {sc.open_count > sc.open.length && <> and {sc.open_count - sc.open.length} more</>}
          </p>
        </section>
      )}
    </>
  ) : (
    <>
      <div class="grid-2">
        <div class="card">
          <h2 style="font-size:1.15rem">What gets scored</h2>
          <p class="small">The last snapshot made before {fmtStamp(s.deadline)}. Every race where both parties' candidates are on the ballot counts once the result is clear; races decided before Election Day don't.</p>
          <p class="small">{lastSnap ? <>The latest snapshot so far: <code>{lastSnap.snapshot}</code>, made {fmtStamp(lastSnap.generated)}.</> : null} Snapshots live in <a href="https://github.com/KaraZajac/MIDTERMS2026/tree/main/data/forecast/snapshots">data/forecast/snapshots</a>. After the deadline the last one is sealed as the GitHub release <a href="https://github.com/KaraZajac/MIDTERMS2026/releases/tag/forecast-of-record"><code>forecast-of-record</code></a>.</p>
        </div>
        <div class="card">
          <h2 style="font-size:1.15rem">Against whom</h2>
          <p class="small">The three model versions, each against the same resolved races as:</p>
          <ul class="small">
            <li><strong>The raters' consensus</strong>, the Cook / Sabato / Inside Elections average mapped to probabilities</li>
            <li><strong>Partisan lean only</strong>, a baseline that ignores polls and candidates</li>
            <li><strong>A coin flip</strong>, 50% everywhere</li>
          </ul>
        </div>
        <div class="card">
          <h2 style="font-size:1.15rem">How</h2>
          <p class="small"><strong>Brier score</strong>: the mean squared gap between the probability and what happened (0 is perfect; a coin flip scores 0.25). <strong>Log loss</strong>: like Brier, but a confident miss costs far more. <strong>Calls</strong>: how many favorites won.</p>
        </div>
        <div class="card">
          <h2 style="font-size:1.15rem">When</h2>
          <p class="small">This page fills in on its own as results land: the repository rescores every few hours after the polls close, and the site rebuilds within ten minutes of each update.</p>
        </div>
      </div>
    </>
  )}
</Base>

<style>
  tr.ours td { font-weight: 700; color: var(--ink-strong); background: var(--accent-wash); }
  @media (max-width: 520px) {
    .provisional :global(.data th), .provisional :global(.data td) { padding-left: 7px; padding-right: 7px; }
    .provisional :global(.data th) { letter-spacing: 0.02em; }
  }
</style>
