---
import Base from "../../layouts/Base.astro";
import VersionBar from "../../components/VersionBar.astro";
import ChamberHead from "../../components/ChamberHead.astro";
import LiveChambers from "../../components/LiveChambers.astro";
import ChamberCard from "../../components/ChamberCard.astro";
import SeatHist from "../../components/SeatHist.astro";
import SeatStrip from "../../components/SeatStrip.astro";
import HouseTable from "../../components/HouseTable.astro";
import { summary } from "../../lib/data.js";
import { VERSIONS, histRange, raceById, raceRating } from "../../lib/model.js";
import { pct, url } from "../../lib/format.js";

const c = summary().chambers.house;
let lo = Infinity, hi = -Infinity;
for (const v of VERSIONS) {
  const [a, b] = histRange(c.versions[v].hist, 0.0005);
  lo = Math.min(lo, a); hi = Math.max(hi, b);
}
---

<Base title="House forecast" description="The 2026 House forecast: every one of the 435 districts, with the chance each party wins it and the distribution of seats in 50,000 simulations.">
  <ChamberHead chamber="house" eyebrow="House forecast · 435 seats · 218 for control">
    <p class="lede">All 435 seats are up. Republicans hold the chamber now; Democrats need a net gain to take it.</p>
  </ChamberHead>
  <LiveChambers chambers={["house"]} />
  <VersionBar />

  <div class="house-top">
    <ChamberCard chamber="house" link={false} histHeight={0} />
    <div class="card">
      <h2 style="font-size:1.1rem">How many seats Democrats win</h2>
      <p class="small muted">Each bar is a seat total and how often it came up in 50,000 simulations. Blue bars are Democratic majorities.</p>
      {VERSIONS.map((v) => (
        <div class={`v v-${v}`}>
          <SeatHist hist={c.versions[v].hist} majority={c.majority} chamber="house" height={220} range={[lo, hi]} />
        </div>
      ))}
    </div>
  </div>

  <section class="section">
    <h2>Every seat, from safest Democratic to safest Republican</h2>
    <p class="section-note">One square per district. Hover or tap for the district; the full list is in the table below.</p>
    <SeatStrip />
  </section>

  <section class="section">
    <h2>Tipping-point districts</h2>
    <p class="section-note">How often each district was the one that decided the majority.</p>
    <div class="tp-list">
      {c.tipping.slice(0, 15).map((t: any) => {
        const r = raceById(t.id);
        return (
          <a class="tp" href={url(`/${t.slug}/`)}>
            <strong>{t.label}</strong>
            <span class="tnum">{pct(t.p, 1)}</span>
            {VERSIONS.map((v) => {
              const rt = raceRating(r, v);
              return <span class={`v v-${v} chip ${rt.key}`}>{rt.label}</span>;
            })}
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <h2>All 435 districts</h2>
    <HouseTable />
  </section>
</Base>

<style>
  .house-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 16px; align-items: start; }
  @media (max-width: 900px) { .house-top { grid-template-columns: minmax(0, 1fr); } }
  .tp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px; }
  .tp {
    display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; align-items: center;
    padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
    text-decoration: none; color: var(--ink);
  }
  .tp:hover { border-color: var(--accent); }
  .tp strong { color: var(--ink-strong); }
  .tp .chip { grid-column: 1 / -1; justify-self: start; }
</style>
